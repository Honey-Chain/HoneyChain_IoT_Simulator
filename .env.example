# HoneyChain IoT Edge Telemetry Simulator Configuration

# Target ingestion endpoint on the HoneyChain Express Backend
# Can be local (http://localhost:5000) or deployed (https://your-service.onrender.com)
# The simulator automatically appends /api/iot/telemetry if not present
IOT_TARGET_URL=http://localhost:5000/api/iot/telemetry

# Transmission interval in milliseconds (default: 600000 = 10 minutes)
# Example for quick testing: 10000 (10 seconds)
IOT_INTERVAL_MS=600000

# HTTP request timeout in milliseconds
REQUEST_TIMEOUT_MS=10000

# Port for the Web Dashboard UI (default: 3001)
UI_PORT=3001

# Optional API key if external edge authentication is enabled
# IOT_API_KEY=your_secret_edge_key

