{
  "name": "honeychain-iot-simulator",
  "version": "1.0.0",
  "description": "Standalone IoT Edge Gateway & Telemetry Simulator for HoneyChain Smart Apiaries",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "once": "node dist/index.js --once",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/ui && cp src/ui/dashboard.html dist/ui/",
    "test": "mocha --node-option import=tsx tests/**/*.test.ts"
  },
  "keywords": [
    "honeychain",
    "iot",
    "simulator",
    "edge",
    "esp32",
    "telemetry",
    "blockchain",
    "beekeeping"
  ],
  "author": "HoneyChain Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
