{
  "name": "honeychain-iot-simulator",
  "version": "1.0.0",
  "description": "Standalone IoT Edge Gateway & Telemetry Simulator for HoneyChain Smart Apiaries",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "mocha --node-option import=tsx tests/**/*.test.ts"
  },
  "keywords": [
    "honeychain",
    "iot",
    "simulator",
    "edge",
    "esp32",
    "telemetry",
    "blockchain",
    "beekeeping"
  ],
  "author": "HoneyChain Team",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
